# PairApp — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores.
# `.env` NUNCA se versiona; este archivo SÍ (PLAN.md §0.7).
# Toda variable nueva se añade a los dos en el mismo commit.

# Postgres.
# Local: la que levanta docker-compose (pnpm db:up). Puerto 5433 para no chocar
# con un Postgres instalado en el sistema, que suele ocupar el 5432.
# Railway: la da el servicio de base de datos en su pestaña Variables.
DATABASE_URL="postgresql://pairapp:pairapp@localhost:5433/pairapp"

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Web Push — generar el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:tu@correo.com"

# Protege la ruta que dispara el cron (PLAN.md §0.2)
# Generar con: openssl rand -hex 32
CRON_SECRET=

# El servidor siempre en UTC (PLAN.md §0.3). No cambiar.
TZ=UTC

# Cloudinary — fotos y notas de voz (fase 2).
# El navegador sube directo allí con una firma que da el servidor: los archivos
# nunca pasan por aquí. Si faltan, la app funciona entera sin adjuntos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
