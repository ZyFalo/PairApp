// Esquema de PairApp.
// Toda tabla de dominio cuelga de un Vinculo para que el aislamiento de RNF-4
// sea estructural, no una convención.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La URL de conexión vive en `prisma.config.ts` (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Vocabulario del dominio (RF-1.1)
// ---------------------------------------------------------------------------

/// Las nueve emociones. Vocabulario fijo y compartido: el valor está en que
/// las dos personas usen las mismas palabras (RF-1.1.8).
enum Emocion {
  BIEN
  AGRADECIDO
  TE_EXTRANO
  TRISTE
  ME_SIENTO_SOLO
  PREOCUPADO
  INCOMODO
  APENADO
  ENOJADO
}

/// Las tres familias de §M1.1.2. No son solo agrupación visual: gobiernan
/// el motor de entrega (§3.0.15).
enum GrupoEmocion {
  ESTOY_CONTIGO
  ME_FALTA_ALGO
  ALGO_PASO
}

/// Qué necesito ahora (RF-1.2). Única fuente legítima sobre lo que alguien
/// necesita: ninguna inferencia puede sustituirla.
enum Necesidad {
  ESCUCHA
  ESPACIO
  DISTRACCION
  CONTACTO
  SOLUCIONES
  NO_SE
}

/// Cuánto comparto de un check-in (RF-1.3).
enum Visibilidad {
  COMPLETO
  SOLO_COLOR
  PRIVADO
}

/// Los que no esperan respuesta y los que sí (§3.2).
enum ClaseMensaje {
  PRESENCIA
  CONVERSACION
}

/// Cuándo llega el mensaje (§2.0). Tres, no cuatro.
enum DestinoMensaje {
  AHORA
  CUANDO_LE_SIRVA
  SOLO_PARA_MI
}

/// Respuestas de un toque para cerrar un hilo (RF-3.19).
enum CierreHilo {
  GRACIAS
  TE_QUIERO
  HABLARLO_MAS
  HABLAMOS_LUEGO
}

/// Franja de entrega de una dedicatoria musical (RF-8.1).
enum FranjaDia {
  MANANA
  TARDE
  NOCHE
}

/// Cómo se conjugan las etiquetas de emoción para esta persona (RF-1.1.9).
/// Es gramática y solo gramática: no dice nada sobre su cuerpo (RF-5.0).
enum GeneroGramatical {
  MASCULINO
  FEMENINO
  NEUTRO
}

/// Cuándo quiero que me avisen de cómo está la otra persona (RF-1.4, RF-3.0.4).
///
/// Por defecto solo lo intenso, y no es tacañería: si el teléfono vibra cada vez
/// que alguien toca un botón, en una semana se silencia la app entera y entonces
/// no llega ni lo que importa.
///
/// Es preferencia de quien **recibe**. No puede abrir nada que quien registra
/// haya cerrado: lo privado no llega ni con `SIEMPRE` (RF-1.3).
enum FrecuenciaDeAnimo {
  SIEMPRE
  SOLO_INTENSO
  NUNCA
}

/// En qué ventanas de los 11:11 participa cada persona (RF-12.1, RF-12.8).
///
/// Un solo ajuste para las dos cosas que pide el documento —elegir ventanas y
/// poder salirse— porque son la misma pregunta: ¿cuándo se abre esto para mí?
/// `NINGUNA` no es "sin aviso": es no participar. Ni ventana ni notificación.
/// Un interruptor que apaga el aviso pero deja la ventana abierta no desactiva
/// nada, solo lo hace más silencioso.
///
/// **Lo que sí se conserva es lo ya escrito.** Salirse del ritual no quema el
/// archivo: la colección sigue ahí y lo que ella deje se sigue leyendo. Es de
/// los dos, y dejar de pedir no es dejar de querer leerlo.
///
/// **La otra persona nunca se entera** (RF-12.8): quien se sale deja de pedir,
/// y no pedir ya era indistinguible de haberse olvidado (RF-12.5).
enum VentanasOnce {
  AMBAS
  MANANA
  NOCHE
  NINGUNA
}

// ---------------------------------------------------------------------------
// Núcleo: personas y vínculo
// ---------------------------------------------------------------------------

/// Una persona. El acceso es por contraseña con Argon2id (PLAN.md §0.1.2):
/// no hay correo transaccional ni recuperación automatizada.
model Usuario {
  id             String           @id @default(cuid())
  correo         String           @unique
  contrasenaHash String
  nombre         String
  genero         GeneroGramatical @default(NEUTRO)
  /// Si esta persona lleva el registro de su ciclo (M5).
  ///
  /// Es un interruptor propio y explícito, **no** se deduce de `genero`:
  /// ese campo dice cómo se conjugan las etiquetas ("agradecido" o
  /// "agradecida"), no qué le pasa a nadie en el cuerpo. Deducir lo segundo
  /// de lo primero sería justo la inferencia que RF-5.3 prohíbe.
  llevaCiclo     Boolean          @default(false)
  /// Si dejo que mi pareja vea mi ánimo día a día en el calendario del mes.
  ///
  /// Apagado de partida y por decisión propia, como el de arriba. Existe porque
  /// el calendario cambia la naturaleza del dato: hasta ahora la pareja solo veía
  /// mi estado **actual**, que caduca a las 8 h (RF-3.0.7.7); un mes entero es
  /// otra cosa — el historial es propio salvo que su dueño diga lo contrario
  /// (RF-1.5). "Hoy estoy triste" y "mira mis últimos treinta días" no son la
  /// misma frase, y no puede darse la segunda por dicha al decir la primera.
  ///
  /// Encenderlo no abre todo: cada día sigue respetando la `Visibilidad` que se
  /// eligió en ese check-in. Lo privado no reaparece nunca por esta puerta.
  compartoAnimo  Boolean          @default(false)
  /// Hasta cuándo esta persona no quiere que la app le hable (§12.2, modo pausa).
  ///
  /// Silencia avisos, no entregas: lo que te manden sigue llegando y te espera
  /// al abrir. Retener las entregas haría que el cofre de la otra persona
  /// dijera "le llegó" cuando no es verdad, y el estado de entrega es un hecho
  /// que no se puede falsear (RF-3.17.4).
  pausaHasta     DateTime?
  zonaHoraria    String           @default("America/Bogota")
  /// Horas locales de la pregunta periódica (RF-1.0). Tres por persona,
  /// desfasadas una hora respecto a las de la pareja (RF-1.0.3).
  horasPregunta  Int[]            @default([9, 14, 19])
  /// En qué ventanas de los 11:11 participo (RF-12.1). Por defecto, las dos.
  ventanasOnce   VentanasOnce     @default(AMBAS)
  /// Cuándo quiero enterarme de cómo está (RF-1.4). Por defecto, solo lo intenso.
  frecuenciaAnimo FrecuenciaDeAnimo @default(SOLO_INTENSO)
  /// Cuándo salió el último aviso hacia esta persona.
  ///
  /// Es lo que permite espaciar lo que decide la app. Sin este dato, las seis
  /// fuentes de aviso del cron no se conocen entre sí y un martes cualquiera
  /// pueden salir seis seguidas (M4).
  ultimoAvisoEn  DateTime?
  /// Cuándo **esta persona** pasó por «empezar» (RF-0.7).
  ///
  /// Va aquí y no solo en `Vinculo` porque la configuración tiene dos mitades y
  /// no se reparten igual: la de módulos se hace **una vez para los dos**, pero
  /// la personal —el ciclo, mi ánimo, mis ventanas— la tiene que hacer cada
  /// quien. Con un único marcador en el vínculo, quien llegaba segundo no veía
  /// nunca la pantalla y se quedaba sin elegir lo suyo.
  empezoEn       DateTime?
  creadoEn       DateTime         @default(now())

  membresia          Membresia?
  invitacionesHechas Invitacion[] @relation("InvitacionCreador")

  @@map("usuario")
}

/// El espacio compartido entre dos personas. Contiene todos los datos.
/// El modelo admite varios vínculos desde el día 1 (D1) aunque la interfaz
/// solo maneje uno.
model Vinculo {
  id       String   @id @default(cuid())
  creadoEn DateTime @default(now())

  // --- Qué módulos usa esta pareja -----------------------------------------
  //
  // Booleanos explícitos y no un array de claves: así cada uno lleva escrito
  // qué significa apagarlo, y añadir uno nuevo obliga a pensarlo.
  //
  // **Encendidos de partida.** Apagado por defecto significa que nadie los
  // descubre; encendido con salida fácil significa que la app llega completa y
  // se poda. Apagar no borra nada: vuelve intacto al encender, igual que el
  // ciclo (RF-5.0).
  //
  // Lo que **no** está aquí, a propósito: el umbral del enojo, el buzón en
  // frío, la ventana de retirada y el amortiguador. Esos no son funciones
  // extra, son los frenos — y un interruptor para los frenos es un interruptor
  // que se toca justo el peor día (P9).

  /// Dedicatorias musicales (M8).
  usaMusica    Boolean @default(true)
  /// Series y películas (M9).
  usaTitulos   Boolean @default(true)
  /// Recuerdos (M11). Apagarlo los quita también del calendario.
  usaRecuerdos Boolean @default(true)
  /// El ritual de los 11:11 (M12). Distinto de `Usuario.ventanasOnce`: esto lo
  /// quita para los dos; aquello es en cuáles participo yo.
  usaOnce      Boolean @default(true)

  /// Cuándo se hizo la elección inicial. Null = todavía no se ha pasado por
  /// «empezar», y ninguna pantalla de la app debería abrirse antes.
  configuradoEn DateTime?

  /// Quién tocó los módulos por última vez, y cuándo.
  ///
  /// Una pestaña que desaparece sin explicación es la clase de cambio silencioso
  /// que esta app evita en todo lo demás (RF-6.4.2). No se avisa a nadie: se
  /// deja dicho en la propia pantalla de ajustes, que es donde se va a mirar.
  modulosPorId String?
  modulosEn    DateTime?

  membresias    Membresia[]
  invitaciones  Invitacion[]
  checkins      Checkin[]
  mensajes      Mensaje[]
  entregas      Entrega[]
  respuestas    Respuesta[]
  guardados     Guardado[]
  onceOnces     OnceOnce[]
  eventos       Evento[]
  dedicatorias  Dedicatoria[]
  ciclos        Ciclo[]
  adjuntos      Adjunto[]
  conflictos    Conflicto[]
  acuerdos      Acuerdo[]
  titulos       Titulo[]
  votosTitulo   VotoTitulo[]
  recuerdos     Recuerdo[]
  suscripciones SuscripcionPush[]

  @@map("vinculo")
}

/// Une a una persona con su vínculo. Un usuario pertenece a un único
/// vínculo activo (RF-0.3), de ahí que `usuarioId` sea único.
model Membresia {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  vinculoId String
  unidoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
  @@map("membresia")
}

/// Código de un solo uso para que la segunda persona entre al vínculo
/// (RF-0.2). Caduca a las 72 h.
model Invitacion {
  id        String    @id @default(cuid())
  codigo    String    @unique
  vinculoId String
  creadorId String
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  creador Usuario @relation("InvitacionCreador", fields: [creadorId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
  @@map("invitacion")
}

// ---------------------------------------------------------------------------
// El bucle: cómo estoy → le dejo algo → se entera → me responde
// ---------------------------------------------------------------------------

/// Registro de cómo estoy (M1). El más reciente es el estado actual, y
/// caduca a las 8 h (RF-3.0.7.7).
model Checkin {
  id          String       @id @default(cuid())
  vinculoId   String
  autorId     String
  emocion     Emocion
  grupo       GrupoEmocion
  intensidad  Int          @default(3)
  necesidad   Necesidad?
  visibilidad Visibilidad  @default(COMPLETO)
  /// Cuándo se avisó a la otra persona de este registro (RF-3.0.1).
  ///
  /// El aviso no sale al registrar sino en la siguiente pasada del cron, y es a
  /// propósito: así da tiempo a escribir el mensaje y sale **un** aviso —«está
  /// triste, te dejó algo»— en vez de dos seguidos por el mismo gesto.
  avisadoEn   DateTime?
  creadoEn    DateTime     @default(now())

  vinculo  Vinculo   @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  mensajes Mensaje[]

  @@index([vinculoId, autorId, creadoEn])
  @@map("checkin")
}

/// Lo que le dejo a mi pareja al registrar cómo estoy (M2).
/// El destino decide cuándo llega; la clase, si espera respuesta.
model Mensaje {
  id        String         @id @default(cuid())
  vinculoId String
  autorId   String
  checkinId String?
  emocion   Emocion
  clase     ClaseMensaje
  destino   DestinoMensaje
  texto     String         @db.Text
  necesidad Necesidad?
  /// "Estoy enojado y quiero que se note" (RF-6.2.1). Contextualiza el
  /// mensaje para quien lo recibe en vez de suavizarlo.
  tonoMarcado Boolean      @default(false)
  /// Solo en destino CUANDO_LE_SIRVA: emociones de la pareja que lo disparan.
  disparadorEmociones Emocion[] @default([])
  /// Un apunte de "solo para mí" que ya se habló o dejó de importar (RF-2.0.8).
  archivadoEn DateTime?
  /// Buzón en frío (§6.3): cuándo toca volver a mirar esto con la cabeza fría.
  ///
  /// El mensaje **no se ha enviado** y la otra persona no sabe que existe
  /// (RF-6.3.1). Al cumplirse la hora, la app pregunta qué hacer con él y las
  /// tres salidas pesan lo mismo: enviarlo, editarlo o dejarlo ir (RF-6.3.3).
  ///
  /// Es el guardarraíl de verdad del módulo, y bloquea por **tiempo**, nunca
  /// por contenido (P9).
  enFrioHasta DateTime?
  /// Borrado con rastro (RF-6.4.2). Un mensaje ya abierto no se puede retirar;
  /// se puede eliminar, pero queda dicho que existió. Nunca se reescribe la
  /// historia en silencio.
  eliminadoEn DateTime?
  creadoEn  DateTime       @default(now())

  vinculo  Vinculo   @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  checkin  Checkin?  @relation(fields: [checkinId], references: [id], onDelete: SetNull)
  entrega  Entrega?
  /// El plan al que esta cápsula está atada, si lo es (RF-7.6).
  capsulaDe Evento?  @relation("CapsulaDelPlan")
  adjunto  Adjunto?
  guardados Guardado[]

  @@index([vinculoId, autorId, creadoEn])
  @@index([vinculoId, destino])
  @@map("mensaje")
}

/// El acto de hacer llegar un mensaje. Guarda los tres estados de hecho
/// (RF-3.0.13): enviado, le llegó, visto. Nunca promesas.
model Entrega {
  id             String    @id @default(cuid())
  vinculoId      String
  mensajeId      String    @unique
  destinatarioId String
  entregadaEn    DateTime  @default(now())
  llegadaEn      DateTime?
  vistaEn        DateTime?
  /// "Lo leyó. Necesita un rato" (RF-3.17). Único acuse voluntario, y solo
  /// después de haber leído.
  necesitaRatoEn DateTime?
  /// Mensaje cálido que se puso delante antes de abrir este (RF-3.0.7).
  amortiguadoConId String?
  /// Hasta cuándo la app deja de insistir con este mensaje (RF-3.0.11).
  ///
  /// Aplazar no es marcarlo como visto: el mensaje sigue sin leer y vuelve
  /// solo cuando pasa la hora. Sin este campo, "ahora no puedo" se comería el
  /// mensaje en silencio, que es exactamente lo que la app existe para evitar.
  pospuestaHasta DateTime?

  vinculo   Vinculo    @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  mensaje   Mensaje    @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  respuesta Respuesta?

  @@index([vinculoId, destinatarioId, vistaEn])
  @@map("entrega")
}

/// La respuesta a un mensaje de conversación (§3.3).
///
/// Lleva `vinculoId` aunque podría deducirse de la entrega: el cliente acotado
/// de RNF-4 inyecta ese campo en **toda** consulta, así que un modelo de dominio
/// sin él revienta al usarse. La regla del esquema no admite excepciones.
model Respuesta {
  id             String      @id @default(cuid())
  vinculoId      String
  entregaId      String      @unique
  autorId        String
  texto          String?     @db.Text
  /// "Y de paso, cómo me dejó" (RF-3.18). Describe mi estado, no puntúa
  /// el mensaje ajeno: por eso reutiliza el vocabulario de emociones.
  emocionAdjunta Emocion?
  cierre         CierreHilo?
  creadoEn       DateTime    @default(now())

  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
  @@map("respuesta")
}

/// Qué se puede adjuntar a un mensaje (fase 2).
enum TipoAdjunto {
  IMAGEN
  AUDIO
}

/// Una foto o una nota de voz dentro de un mensaje (fase 2).
///
/// Uno por mensaje a propósito: esto es una carta, no una galería. Poder
/// mandar doce fotos convertiría el gesto en otra cosa.
///
/// El archivo vive en Cloudinary, no aquí. Se guarda `publicId` además de la
/// URL porque sin él no se puede borrar de allí cuando se elimina el mensaje,
/// y un archivo huérfano en la nube es un archivo que nadie sabe que existe.
model Adjunto {
  id        String      @id @default(cuid())
  vinculoId String
  mensajeId String      @unique
  tipo      TipoAdjunto
  url       String      @db.Text
  publicId  String
  /// Solo en audio: cuánto dura, para pintar el reproductor sin descargarlo.
  segundos  Int?
  creadoEn  DateTime    @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
  @@map("adjunto")
}

// ---------------------------------------------------------------------------
// Después de una discusión (M6, fase 3)
// ---------------------------------------------------------------------------

/// Un conflicto contado en cuatro campos (§6.6), en el formato de la
/// Comunicación No Violenta: hechos, sentimiento, necesidad, y qué haría
/// distinto.
///
/// **Nace privado.** `compartidoEn` es null hasta que su autor decide que la
/// otra persona lo vea (RF-6.6.1). Escribirlo ya sirve aunque no se comparta
/// nunca: ordenar lo que pasó es la mitad del trabajo.
model Conflicto {
  id        String @id @default(cuid())
  vinculoId String
  autorId   String
  /// Hechos observables, sin interpretación. El campo más difícil y el que
  /// más ayuda: "llegaste a las diez" no admite discusión; "no te importó" sí.
  quePaso           String @db.Text
  queSenti          String @db.Text
  queNecesitaba     String @db.Text
  queHariaDistinto  String @db.Text
  /// Cuándo se compartió, si se compartió (RF-6.6.1).
  compartidoEn DateTime?
  /// Si es la respuesta al relato de la otra persona, en el mismo formato.
  respondeAId  String?
  creadoEn     DateTime @default(now())

  vinculo   Vinculo     @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  respondeA Conflicto?  @relation("RelatoYRespuesta", fields: [respondeAId], references: [id], onDelete: SetNull)
  respuestas Conflicto[] @relation("RelatoYRespuesta")

  @@index([vinculoId, autorId, creadoEn])
  @@map("conflicto")
}

/// Un acuerdo breve al que llegaron los dos (§6.7).
///
/// Editable por ambos a propósito: un acuerdo del que solo uno es dueño no es
/// un acuerdo. Archivar en vez de borrar, porque saber qué se acordó y se dejó
/// de cumplir también es información.
model Acuerdo {
  id          String    @id @default(cuid())
  vinculoId   String
  texto       String    @db.Text
  creadorId   String
  archivadoEn DateTime?
  creadoEn    DateTime  @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, archivadoEn])
  @@map("acuerdo")
}

// ---------------------------------------------------------------------------
// Series y películas (M9) y recuerdos (M11)
// ---------------------------------------------------------------------------

enum TipoTitulo {
  SERIE
  PELICULA
}

/// En qué punto está un título de la lista compartida (RF-9.1).
enum EstadoTitulo {
  POR_VER
  VIENDO
  VISTA
  ABANDONADA
}

/// Algo que quieren ver, están viendo o ya vieron (M9).
model Titulo {
  id            String       @id @default(cuid())
  vinculoId     String
  nombre        String
  tipo          TipoTitulo   @default(PELICULA)
  estado        EstadoTitulo @default(POR_VER)
  propuestoPorId String
  /// "No la veas sin mí" (RF-9.5). Suena tonto y es una fuente real de
  /// conflicto: verse un capítulo solo, en una serie que era de los dos, duele
  /// más de lo que parece. Poder decirlo antes evita tener que reprocharlo
  /// después.
  soloJuntos    Boolean      @default(false)
  /// Por dónde van, para no perder el hilo (RF-9.4).
  temporada     Int?
  episodio      Int?
  /// Metadatos de TMDB, si hubo búsqueda (RF-9.6). Nulos si se escribió a mano.
  anio          Int?
  posterUrl     String?      @db.Text
  sinopsis      String?      @db.Text
  /// Minutos aproximados, para el selector al azar por duración (RF-9.7).
  minutos       Int?
  creadoEn      DateTime     @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  votos   VotoTitulo[]

  @@index([vinculoId, estado])
  @@map("titulo")
}

/// Lo que le pareció a cada uno (RF-9.3). Uno por persona y título: la gracia
/// es justo que puedan no coincidir.
model VotoTitulo {
  id         String   @id @default(cuid())
  vinculoId  String
  tituloId   String
  usuarioId  String
  puntuacion Int
  comentario String?  @db.Text
  creadoEn   DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  titulo  Titulo  @relation(fields: [tituloId], references: [id], onDelete: Cascade)

  @@unique([tituloId, usuarioId])
  @@index([vinculoId])
  @@map("voto_titulo")
}

/// Un momento de la relación que merece quedarse (M11).
///
/// La fecha es la del recuerdo, no la del día en que se escribió: sirve para
/// ordenar la línea de tiempo y para que "hace un año" tenga sentido (RF-11.2).
model Recuerdo {
  id        String   @id @default(cuid())
  vinculoId String
  autorId   String
  titulo    String
  nota      String?  @db.Text
  /// Cuándo pasó. Solo el día: la hora exacta de un recuerdo no le importa a nadie.
  ocurrioEl DateTime @db.Date
  /// Foto, si hay. Vive en Cloudinary como el resto de adjuntos.
  fotoUrl   String?  @db.Text
  fotoPublicId String?
  creadoEn  DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, ocurrioEl])
  @@map("recuerdo")
}

/// El cofre: mensajes que quien los recibió decidió conservar (§3.2.2).
/// La señal solo existe en positivo — no hay "no guardado" (RF-3.9.1).
model Guardado {
  id        String   @id @default(cuid())
  vinculoId String
  mensajeId String
  usuarioId String
  creadoEn  DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@unique([mensajeId, usuarioId])
  @@index([vinculoId, usuarioId])
  @@map("guardado")
}

// ---------------------------------------------------------------------------
// Los 11:11 (M12)
// ---------------------------------------------------------------------------

/// Un deseo de las 11:11. Máximo 140 caracteres: es un deseo, no una carta.
/// Sin rachas ni contadores — un 11:11 perdido no existe (RF-12.7).
model OnceOnce {
  id        String   @id @default(cuid())
  vinculoId String
  autorId   String
  texto     String   @db.VarChar(140)
  /// Fecha local (YYYY-MM-DD) y si fue el de la mañana o el de la noche.
  /// Sirve para saber si los dos pidieron en la misma ventana (RF-12.4).
  dia       String
  esNoche   Boolean  @default(false)
  creadoEn  DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, dia])
  @@map("once_once")
}

// ---------------------------------------------------------------------------
// La vida en común
// ---------------------------------------------------------------------------

/// Evento del calendario compartido (M7). Uno solo para los dos; un evento
/// puede ser de pareja o individual.
model Evento {
  id          String   @id @default(cuid())
  vinculoId   String
  creadorId   String
  titulo      String
  tipo        String   @default("cita")
  inicio      DateTime
  fin         DateTime?
  todoElDia   Boolean  @default(false)
  /// Se repite cada año en la misma fecha (RF-7.3): cumpleaños, aniversarios.
  ///
  /// No se guardan copias, se calcula la ocurrencia al pintar el mes. Sembrar
  /// una fila por año obligaría a decidir cuántos años por delante —y a que
  /// editar el cumpleaños de alguien fuera editar veinte filas—.
  anual       Boolean  @default(false)
  esDePareja  Boolean  @default(true)
  notas       String?  @db.Text
  /// Aviso previo en horas. Null = sin recordatorio.
  avisoHoras  Int?
  avisadoEn   DateTime?
  /// Un mensaje escrito hoy que se entrega **el día del plan** (RF-7.6).
  ///
  /// Es un `Mensaje` normal y no un tipo nuevo, para que herede la entrega, la
  /// respuesta y el cofre sin duplicar nada. Va con destino `CUANDO_LE_SIRVA`
  /// y sin disparadores: quien decide cuándo sale es este plan, no una emoción.
  ///
  /// **Quien la recibe no sabe que existe** hasta que llega. Ni marca en el
  /// calendario, ni cuenta atrás (RF-3.0.13.1): un reloj corriendo hacia una
  /// sorpresa la estropea. Solo su autor ve que la dejó puesta.
  capsulaId   String?  @unique
  capsula     Mensaje? @relation("CapsulaDelPlan", fields: [capsulaId], references: [id], onDelete: SetNull)
  creadoEn    DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, inicio])
  @@map("evento")
}

/// Canción dedicada (M8). Solo enlace pegado: sin API de Spotify, sin OAuth
/// (D28, D30).
model Dedicatoria {
  id          String    @id @default(cuid())
  vinculoId   String
  autorId     String
  url         String
  titulo      String?
  miniaturaUrl String?
  mensaje     String?   @db.Text
  franja      FranjaDia
  entregadaEn DateTime?
  creadoEn    DateTime  @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, franja, entregadaEn])
  @@map("dedicatoria")
}

/// Registro de periodo (M5). El diseño está invertido a propósito: la app no
/// le dice a nadie cómo está la otra persona; ella decide qué comparte
/// (RF-5.3), y nunca se correlaciona ánimo con ciclo (RF-5.6).
model Ciclo {
  id        String    @id @default(cuid())
  vinculoId String
  usuarioId String
  inicio    DateTime  @db.Date
  fin       DateTime? @db.Date
  /// Nada / solo fechas / fechas + nota (RF-5.3).
  nivelVisibilidad String @default("SOLO_FECHAS")
  notaParaPareja   String? @db.Text

  /// Síntomas del 1 al 5 (RF-5.1). **Nunca se comparten**, ni siquiera con
  /// el nivel más abierto de RF-5.3: son para mirar el propio historial.
  ///
  /// Dárselos a la pareja convertiría el módulo en lo que §M5 evita — un panel
  /// desde el que deducir cómo está ella. Lo que quiera que él sepa lo escribe
  /// en `notaParaPareja`, con sus palabras.
  dolor     Int?
  energia   Int?
  sueno     Int?
  antojos   Boolean   @default(false)

  creadoEn  DateTime  @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, usuarioId, inicio])
  @@map("ciclo")
}

/// Suscripción del navegador a Web Push (M4). Una por dispositivo.
model SuscripcionPush {
  id        String   @id @default(cuid())
  vinculoId String
  usuarioId String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  creadoEn  DateTime @default(now())

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, usuarioId])
  @@map("suscripcion_push")
}
